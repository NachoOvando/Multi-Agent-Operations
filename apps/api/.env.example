# Copiar a .env (nunca commitear .env real — ya está en .gitignore).

# Prefijo obligatorio postgresql+psycopg:// (psycopg v3) — NO usar
# postgresql:// a secas, apunta por default a psycopg2 (no instalado acá).
# Ver apps/api/src/db/session.py para el detalle de por qué.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/agentes_operativos

# Requerida por LiteLlm (google.adk.models.lite_llm) para llamar modelos Claude.
ANTHROPIC_API_KEY=

# Auth (Slice 1) — JWT propio emitido/verificado por FastAPI.
# JWT_SECRET_KEY: secreto de firma HS256. Generar uno fuerte por entorno, ej.
# `python -c "import secrets; print(secrets.token_urlsafe(64))"` — NUNCA
# reusar el mismo valor entre dev/staging/prod ni commitear el real.
JWT_SECRET_KEY=
# Minutos de validez del access_token. Default en código si se omite: 480 (8h).
JWT_EXPIRES_MINUTES=480

# CORS: único origen de browser permitido (ej. la URL de Vercel del
# frontend). Sin esta variable, CORSMiddleware no permite ningún origen
# (fail-closed) — ver main.py.
ALLOWED_ORIGIN=
