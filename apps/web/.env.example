# Secreto de cifrado de sesión de Auth.js (NextAuth v5). Generar con:
#   npx auth secret
AUTH_SECRET=

# URL base del backend FastAPI (apps/api) en Railway. Server-only — nunca
# prefijar con NEXT_PUBLIC_*, nunca importar fuera de auth.ts y
# app/api/backend/[...path]/route.ts. El navegador nunca la ve directamente:
# toda llamada del cliente pasa por /api/backend/... (proxy BFF propio).
BACKEND_API_URL=

# Opcional en Vercel — Auth.js v5 infiere la URL pública a partir de
# VERCEL_URL en ese entorno. Solo hace falta setearla explícitamente en dev
# local o en otros hosts (ej. http://localhost:3000).
NEXTAUTH_URL=
